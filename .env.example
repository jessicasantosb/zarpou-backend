# ==========================================
# ZARPOU VIAGENS BACKEND - CONFIGURAÇÕES
# ==========================================

PROJECT_NAME="Zarpou Viagens & Turismo API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# DATABASE (Por padrão usa SQLite para desenvolvimento ágil. Substitua para PostgreSQL em produção)
# Exemplo PostgreSQL: postgresql://user:password@localhost:5432/zarpou_db
DATABASE_URL="sqlite:///./zarpou.db"

# SEGURANÇA & JWT
SECRET_KEY="zarpou_super_secret_jwt_key_change_in_production_xyz123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Origens permitidas, como o Next.js)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# INTEGRAÇÕES OPCIONAIS (Preencha com suas chaves quando disponíveis)
RESEND_API_KEY=""
AI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
WHATSAPP_API_TOKEN=""

# URL do frontend usada nos e-mails (links de recuperacao de senha).
FRONTEND_URL="https://www.zarpouviagens.com.br"


# Redis (Celery broker/result) para processamento em background (importacoes em massa)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
